{% doc %}
  @prompt
    a testimonial slider.
    
    heading column contains, section title on left, left and right arrow to navigate the slider on the right. 
    
    slider displaying 3 on desktop, show overflow visible. but blur all other slide that is not in the view. 
    
    showing 3 on desktop, 2 on tablet, 1 on mobile. 
    
    each slide contains. 
    -5 star icon
    -name + green circle icon with white check inside. name is 16px desktop 14px mobile. green icon is 20px desktop, 15px mobile
    -testimonial richtext 60% black. 16px desktop 14px mobile
    
    star is 22px 22px space between 6px. and mobile star is 19px 19px space between 5px
    
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-testimonial-slider-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    display: block;
  }

  .ai-testimonial-slider__header-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 40px;
  }

  .ai-testimonial-slider__title-{{ ai_gen_id }} {
    margin: 0;
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
  }

  .ai-testimonial-slider__nav-{{ ai_gen_id }} {
    display: flex;
    gap: 12px;
  }

  .ai-testimonial-slider__nav-button-{{ ai_gen_id }} {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    border: none;
    background-color: {{ block.settings.nav_button_bg }};
    color: {{ block.settings.nav_button_color }};
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.3s ease;
  }

  .ai-testimonial-slider__nav-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.nav_button_hover_bg }};
  }

  .ai-testimonial-slider__nav-button-{{ ai_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .ai-testimonial-slider__nav-button-{{ ai_gen_id }} svg {
    width: 20px;
    height: 20px;
  }

  .ai-testimonial-slider__track-wrapper-{{ ai_gen_id }} {
    overflow: visible;
    position: relative;
  }

  .ai-testimonial-slider__track-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.slide_gap }}px;
    transition: transform 0.5s ease;
  }

  .ai-testimonial-slider__slide-{{ ai_gen_id }} {
    flex: 0 0 calc((100% - ({{ block.settings.slide_gap }}px * 2)) / 3);
    background-color: {{ block.settings.slide_bg }};
    border-radius: {{ block.settings.slide_border_radius }}px;
    padding: {{ block.settings.slide_padding }}px;
    transition: filter 0.5s ease;
  }

  .ai-testimonial-slider__slide-{{ ai_gen_id }}.blurred {
    filter: blur(4px);
  }

  .ai-testimonial-slider__stars-{{ ai_gen_id }} {
    display: flex;
    gap: 6px;
    margin-bottom: 16px;
  }

  .ai-testimonial-slider__star-{{ ai_gen_id }} {
    width: 22px;
    height: 22px;
    color: {{ block.settings.star_color }};
  }

  .ai-testimonial-slider__author-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 16px;
  }

  .ai-testimonial-slider__author-name-{{ ai_gen_id }} {
    font-size: 16px;
    font-weight: 600;
    color: {{ block.settings.name_color }};
    margin: 0;
  }

  .ai-testimonial-slider__verified-icon-{{ ai_gen_id }} {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
  }

  .ai-testimonial-slider__text-{{ ai_gen_id }} {
    font-size: 16px;
    line-height: 1.6;
    color: {{ block.settings.text_color }};
  }

  .ai-testimonial-slider__text-{{ ai_gen_id }} p {
    margin: 0;
  }

  @media screen and (max-width: 989px) {
    .ai-testimonial-slider__slide-{{ ai_gen_id }} {
      flex: 0 0 calc((100% - {{ block.settings.slide_gap }}px) / 2);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-testimonial-slider__header-{{ ai_gen_id }} {
      margin-bottom: 24px;
    }

    .ai-testimonial-slider__slide-{{ ai_gen_id }} {
      flex: 0 0 100%;
    }

    .ai-testimonial-slider__stars-{{ ai_gen_id }} {
      gap: 5px;
      margin-bottom: 12px;
    }

    .ai-testimonial-slider__star-{{ ai_gen_id }} {
      width: 19px;
      height: 19px;
    }

    .ai-testimonial-slider__author-{{ ai_gen_id }} {
      margin-bottom: 12px;
    }

    .ai-testimonial-slider__author-name-{{ ai_gen_id }} {
      font-size: 14px;
    }

    .ai-testimonial-slider__verified-icon-{{ ai_gen_id }} {
      width: 15px;
      height: 15px;
    }

    .ai-testimonial-slider__text-{{ ai_gen_id }} {
      font-size: 14px;
    }
  }
{% endstyle %}

<testimonial-slider-{{ ai_gen_id }} class="ai-testimonial-slider-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-testimonial-slider__header-{{ ai_gen_id }}">
    {% if block.settings.section_title != blank %}
      <h2 class="ai-testimonial-slider__title-{{ ai_gen_id }}">{{ block.settings.section_title }}</h2>
    {% endif %}
    <div class="ai-testimonial-slider__nav-{{ ai_gen_id }}">
      <button class="ai-testimonial-slider__nav-button-{{ ai_gen_id }}" data-direction="prev" aria-label="Previous testimonial">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>
      <button class="ai-testimonial-slider__nav-button-{{ ai_gen_id }}" data-direction="next" aria-label="Next testimonial">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    </div>
  </div>

  <div class="ai-testimonial-slider__track-wrapper-{{ ai_gen_id }}">
    <div class="ai-testimonial-slider__track-{{ ai_gen_id }}">
      {% for i in (1..6) %}
        {% liquid
          assign name_key = 'testimonial_' | append: i | append: '_name'
          assign text_key = 'testimonial_' | append: i | append: '_text'
          assign name = block.settings[name_key]
          assign text = block.settings[text_key]
        %}
        {% if name != blank or text != blank %}
          <div class="ai-testimonial-slider__slide-{{ ai_gen_id }}" data-slide-index="{{ forloop.index0 }}">
            <div class="ai-testimonial-slider__stars-{{ ai_gen_id }}">
              {% for star in (1..5) %}
                <svg class="ai-testimonial-slider__star-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                </svg>
              {% endfor %}
            </div>

            <div class="ai-testimonial-slider__author-{{ ai_gen_id }}">
              {% if name != blank %}
                <h3 class="ai-testimonial-slider__author-name-{{ ai_gen_id }}">{{ name }}</h3>
              {% endif %}
              <svg class="ai-testimonial-slider__verified-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none">
                <circle cx="12" cy="12" r="10" fill="{{ block.settings.verified_bg }}"/>
                <path d="M9 12l2 2 4-4" stroke="{{ block.settings.verified_check }}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>

            {% if text != blank %}
              <div class="ai-testimonial-slider__text-{{ ai_gen_id }}">
                {{ text }}
              </div>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</testimonial-slider-{{ ai_gen_id }}>

<script>
  (function() {
    class TestimonialSlider{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentIndex = 0;
        this.slidesPerView = 3;
      }

      connectedCallback() {
        this.track = this.querySelector('.ai-testimonial-slider__track-{{ ai_gen_id }}');
        this.slides = Array.from(this.querySelectorAll('.ai-testimonial-slider__slide-{{ ai_gen_id }}'));
        this.prevButton = this.querySelector('[data-direction="prev"]');
        this.nextButton = this.querySelector('[data-direction="next"]');

        this.updateSlidesPerView();
        this.updateSlider();
        this.setupEventListeners();
      }

      setupEventListeners() {
        this.prevButton.addEventListener('click', () => this.navigate('prev'));
        this.nextButton.addEventListener('click', () => this.navigate('next'));

        window.addEventListener('resize', () => {
          this.updateSlidesPerView();
          this.updateSlider();
        });
      }

      updateSlidesPerView() {
        if (window.innerWidth <= 749) {
          this.slidesPerView = 1;
        } else if (window.innerWidth <= 989) {
          this.slidesPerView = 2;
        } else {
          this.slidesPerView = 3;
        }
      }

      navigate(direction) {
        if (direction === 'prev') {
          this.currentIndex = Math.max(0, this.currentIndex - 1);
        } else {
          this.currentIndex = Math.min(this.slides.length - this.slidesPerView, this.currentIndex + 1);
        }
        this.updateSlider();
      }

      updateSlider() {
        const slideWidth = this.slides[0].offsetWidth;
        const gap = {{ block.settings.slide_gap }};
        const offset = this.currentIndex * (slideWidth + gap);

        this.track.style.transform = `translateX(-${offset}px)`;

        this.prevButton.disabled = this.currentIndex === 0;
        this.nextButton.disabled = this.currentIndex >= this.slides.length - this.slidesPerView;

        this.slides.forEach((slide, index) => {
          const isInView = index >= this.currentIndex && index < this.currentIndex + this.slidesPerView;
          if (isInView) {
            slide.classList.remove('blurred');
          } else {
            slide.classList.add('blurred');
          }
        });
      }
    }

    customElements.define('testimonial-slider-{{ ai_gen_id }}', TestimonialSlider{{ ai_gen_id }});
  })();
</script>

