{% doc %}
  @prompt
    three column
    
    each column contains counter number, suffix on the number,
    sub title on the counter. 
    
    let me set spacing and font sizing for mobile and desktop. 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-counter-stats-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.desktop_spacing }}px 0;
  }

  .ai-counter-stats__container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    width: 100%;
  }

  .ai-counter-stats__column-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    gap: {{ block.settings.desktop_item_gap }}px;
    padding: 0 {{ block.settings.desktop_column_gap }}px;
  }

  .ai-counter-stats__column-{{ ai_gen_id }}:first-child {
    padding-left: 0;
  }

  .ai-counter-stats__column-{{ ai_gen_id }}:last-child {
    padding-right: 0;
  }

  .ai-counter-stats__column-{{ ai_gen_id }} + .ai-counter-stats__column-{{ ai_gen_id }} {
    border-left: {{ block.settings.divider_width }}px solid {{ block.settings.divider_color }};
  }

  .ai-counter-stats__number-wrapper-{{ ai_gen_id }} {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 4px;
  }

  .ai-counter-stats__number-{{ ai_gen_id }} {
    font-size: {{ block.settings.desktop_number_size }}px;
    font-weight: 700;
    color: {{ block.settings.number_color }};
    line-height: 1.2;
  }

  .ai-counter-stats__suffix-{{ ai_gen_id }} {
    font-size: {{ block.settings.desktop_suffix_size }}px;
    font-weight: 700;
    color: {{ block.settings.suffix_color }};
    line-height: 1.2;
  }

  .ai-counter-stats__subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.desktop_subtitle_size }}px;
    color: {{ block.settings.subtitle_color }};
    line-height: 1.4;
  }

  @media screen and (max-width: 749px) {
    .ai-counter-stats-{{ ai_gen_id }} {
      padding: {{ block.settings.mobile_spacing }}px 0;
    }

    .ai-counter-stats__container-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
      grid-template-rows: auto auto;
      row-gap: {{ block.settings.mobile_row_gap }}px;
      padding-left: 30px;
      padding-right: 30px;
    }

    /* Third column: span full width and center */
    .ai-counter-stats__column-{{ ai_gen_id }}:nth-child(3) {
      grid-column: 1 / -1;
      align-items: center;
      text-align: center;
      border-left: none;

      padding: {{ block.settings.mobile_row_gap }}px 0 0;
    }

    /* Remove top row bottom padding and reset side borders on mobile */
    .ai-counter-stats__column-{{ ai_gen_id }} {
      gap: {{ block.settings.mobile_item_gap }}px;
      padding: 0 {{ block.settings.mobile_column_gap }}px;
    }

    .ai-counter-stats__column-{{ ai_gen_id }}:first-child {
      padding-left: 0;
    }

    .ai-counter-stats__column-{{ ai_gen_id }}:nth-child(2) {
      padding-right: 0;
      padding-left: 30px;
    }

    .ai-counter-stats__number-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_number_size }}px;
    }

    .ai-counter-stats__suffix-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_suffix_size }}px;
    }

    .ai-counter-stats__subtitle-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_subtitle_size }}px;
    }
  }
{% endstyle %}

<counter-stats-{{ ai_gen_id }} class="ai-counter-stats-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-counter-stats__container-{{ ai_gen_id }}">
    {% for i in (1..3) %}
      {% liquid
        assign number_key = 'column_' | append: i | append: '_number'
        assign suffix_key = 'column_' | append: i | append: '_suffix'
        assign subtitle_key = 'column_' | append: i | append: '_subtitle'
        
        assign number = block.settings[number_key]
        assign suffix = block.settings[suffix_key]
        assign subtitle = block.settings[subtitle_key]
      %}
      
      <div class="ai-counter-stats__column-{{ ai_gen_id }}">
        <div class="ai-counter-stats__number-wrapper-{{ ai_gen_id }}">
          <span class="ai-counter-stats__number-{{ ai_gen_id }}" data-target="{{ number }}">0</span>
          {% if suffix != blank %}
            <span class="ai-counter-stats__suffix-{{ ai_gen_id }}">{{ suffix }}</span>
          {% endif %}
        </div>
        {% if subtitle != blank %}
          <div class="ai-counter-stats__subtitle-{{ ai_gen_id }}">{{ subtitle }}</div>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</counter-stats-{{ ai_gen_id }}>

<script>
  (function() {
    class CounterStats{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.animated = false;
      }

      connectedCallback() {
        this.setupIntersectionObserver();
      }

      setupIntersectionObserver() {
        const options = {
          root: null,
          rootMargin: '0px',
          threshold: 0.3
        };

        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting && !this.animated) {
              this.animateCounters();
              this.animated = true;
            }
          });
        }, options);

        observer.observe(this);
      }

      animateCounters() {
        const counters = this.querySelectorAll('.ai-counter-stats__number-{{ ai_gen_id }}');
        
        counters.forEach((counter) => {
          const target = parseInt(counter.getAttribute('data-target'));
          const duration = 2000;
          const increment = target / (duration / 16);
          let current = 0;

          const updateCounter = () => {
            current += increment;
            if (current < target) {
              counter.textContent = Math.floor(current).toLocaleString();
              requestAnimationFrame(updateCounter);
            } else {
              counter.textContent = target.toLocaleString();
            }
          };

          updateCounter();
        });
      }
    }

    customElements.define('counter-stats-{{ ai_gen_id }}', CounterStats{{ ai_gen_id }});
  })();
</script>

