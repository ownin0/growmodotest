{% doc %}
  @prompt
    Testimonials carousel "OUR HAPPY CUSTOMERS"

    Section heading on the left, prev/next arrow buttons on the right.
    Horizontally scrollable cards showing customer reviews.
    Each card: 5-star rating (yellow), reviewer name + green verified checkmark, review text.
    Desktop: 3 cards visible. Mobile: 1 card (80% width).
    Up to 6 testimonials configurable via settings.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-testimonials-{{ ai_gen_id }} {
    width: 100%;
  }

  .ai-testimonials__header-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 32px;
  }

  .ai-testimonials__title-{{ ai_gen_id }} {
    font-size: 36px;
    font-weight: 700;
    margin: 0;
    letter-spacing: -0.5px;
  }

  .ai-testimonials__nav-{{ ai_gen_id }} {
    display: flex;
    gap: 12px;
    flex-shrink: 0;
  }

  .ai-testimonials__btn-{{ ai_gen_id }} {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid #e0e0e0;
    background: white;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s, border-color 0.2s;
    padding: 0;
  }

  .ai-testimonials__btn-{{ ai_gen_id }}:hover {
    background: #f5f5f5;
    border-color: #bdbdbd;
  }

  .ai-testimonials__btn-{{ ai_gen_id }} svg {
    width: 18px;
    height: 18px;
  }

  .ai-testimonials__track-wrapper-{{ ai_gen_id }} {
    overflow: hidden;
  }

  .ai-testimonials__track-{{ ai_gen_id }} {
    display: flex;
    gap: 20px;
    transition: transform 0.4s ease;
    will-change: transform;
  }

  .ai-testimonials__card-{{ ai_gen_id }} {
    flex: 0 0 calc(33.333% - 14px);
    border: 1px solid #e8e8e8;
    border-radius: 20px;
    padding: 28px;
    box-sizing: border-box;
  }

  .ai-testimonials__stars-{{ ai_gen_id }} {
    display: flex;
    gap: 4px;
    margin-bottom: 14px;
  }

  .ai-testimonials__star-{{ ai_gen_id }} {
    width: 20px;
    height: 20px;
    fill: #f5a623;
  }

  .ai-testimonials__name-row-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 10px;
  }

  .ai-testimonials__name-{{ ai_gen_id }} {
    font-weight: 700;
    font-size: 17px;
    margin: 0;
  }

  .ai-testimonials__check-{{ ai_gen_id }} {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
  }

  .ai-testimonials__review-{{ ai_gen_id }} {
    font-size: 14px;
    color: #606060;
    line-height: 1.65;
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-testimonials__title-{{ ai_gen_id }} {
      font-size: 26px;
    }

    .ai-testimonials__header-{{ ai_gen_id }} {
      margin-bottom: 20px;
    }

    .ai-testimonials__card-{{ ai_gen_id }} {
      flex: 0 0 82%;
      padding: 20px;
    }
  }
{% endstyle %}

<div class="ai-testimonials-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-testimonials__header-{{ ai_gen_id }}">
    <h2 class="ai-testimonials__title-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    <div class="ai-testimonials__nav-{{ ai_gen_id }}">
      <button class="ai-testimonials__btn-{{ ai_gen_id }}" id="prev-{{ ai_gen_id }}" aria-label="Previous testimonials">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
      <button class="ai-testimonials__btn-{{ ai_gen_id }}" id="next-{{ ai_gen_id }}" aria-label="Next testimonials">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M9 18l6-6-6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>
  </div>

  <div class="ai-testimonials__track-wrapper-{{ ai_gen_id }}">
    <div class="ai-testimonials__track-{{ ai_gen_id }}" id="track-{{ ai_gen_id }}">
      {% for i in (1..6) %}
        {% liquid
          assign name_key   = 'review_' | append: i | append: '_name'
          assign rating_key = 'review_' | append: i | append: '_rating'
          assign text_key   = 'review_' | append: i | append: '_text'
          assign name   = block.settings[name_key]
          assign rating = block.settings[rating_key]
          assign text   = block.settings[text_key]
        %}
        {% if name != blank or text != blank %}
          <div class="ai-testimonials__card-{{ ai_gen_id }}">
            <div class="ai-testimonials__stars-{{ ai_gen_id }}">
              {% for s in (1..5) %}
                {% if s <= rating %}
                  <svg class="ai-testimonials__star-{{ ai_gen_id }}" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <polygon points="12,2 15.09,8.26 22,9.27 17,14.14 18.18,21.02 12,17.77 5.82,21.02 7,14.14 2,9.27 8.91,8.26"/>
                  </svg>
                {% else %}
                  <svg class="ai-testimonials__star-{{ ai_gen_id }}" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" style="fill:none;stroke:#f5a623;stroke-width:1.5">
                    <polygon points="12,2 15.09,8.26 22,9.27 17,14.14 18.18,21.02 12,17.77 5.82,21.02 7,14.14 2,9.27 8.91,8.26"/>
                  </svg>
                {% endif %}
              {% endfor %}
            </div>
            <div class="ai-testimonials__name-row-{{ ai_gen_id }}">
              <span class="ai-testimonials__name-{{ ai_gen_id }}">{{ name }}</span>
              <svg class="ai-testimonials__check-{{ ai_gen_id }}" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="12" cy="12" r="10" fill="#01ab31"/>
                <path d="M8 12.5l3 3 5-5" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            {% if text != blank %}
              <p class="ai-testimonials__review-{{ ai_gen_id }}">{{ text }}</p>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

<script>
  (function () {
    var track = document.getElementById('track-{{ ai_gen_id }}');
    var btnPrev = document.getElementById('prev-{{ ai_gen_id }}');
    var btnNext = document.getElementById('next-{{ ai_gen_id }}');

    if (!track || !btnPrev || !btnNext) return;

    var currentIndex = 0;

    function getVisibleCount() {
      return window.innerWidth <= 749 ? 1 : 3;
    }

    function getCards() {
      return track.querySelectorAll('.ai-testimonials__card-{{ ai_gen_id }}');
    }

    function getMaxIndex() {
      var cards = getCards();
      return Math.max(0, cards.length - getVisibleCount());
    }

    function updateTrack() {
      var cards = getCards();
      if (cards.length === 0) return;
      var gap = 20;
      var cardWidth = cards[0].offsetWidth;
      var offset = currentIndex * (cardWidth + gap);
      track.style.transform = 'translateX(-' + offset + 'px)';
    }

    btnPrev.addEventListener('click', function () {
      currentIndex = Math.max(0, currentIndex - 1);
      updateTrack();
    });

    btnNext.addEventListener('click', function () {
      currentIndex = Math.min(getMaxIndex(), currentIndex + 1);
      updateTrack();
    });

    window.addEventListener('resize', function () {
      currentIndex = Math.min(currentIndex, getMaxIndex());
      updateTrack();
    });
  })();
</script>

