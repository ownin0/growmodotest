{% doc %}
  @prompt
    4 box.  2 column 2 row.
    
    first row, 30% 70%
    second riw 70% 30%
    
    each row contains
    -title
    -link for the whole box. 
    -image that is position absolutel right 0 top 0 bottom 0 width: 70 on desktop and 60 on mobile. object fit contain
    
    mobile is 1 column 4 row set min height of 300px, first row: 40% 60%
    second row: 60% 40%.
    
    image absolute is height 100% top 0 right 0 bototm 0 width: 75%
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-box-grid-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .ai-box-grid__container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 40% 60%;
    grid-template-rows: auto auto;
    gap: 0 {{ block.settings.gap }}px;
  }

  .ai-box-grid__box-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.border_radius }}px;
    background-color: {{ block.settings.box_background_color }};
    padding: {{ block.settings.padding }}px;
    min-height: 300px;
    display: flex;
    align-items: flex-start;
  }

  .ai-box-grid__box-{{ ai_gen_id }}:nth-child(1) {
    grid-column: 1 / 2;
  }

  .ai-box-grid__box-{{ ai_gen_id }}:nth-child(2) {
    grid-column: 2 / 3;
  }

  .ai-box-grid__box-{{ ai_gen_id }}:nth-child(3) {
    grid-column: 1 / 3;
  }

  .ai-box-grid__box-{{ ai_gen_id }}:nth-child(4) {
    grid-column: 3 / 4;
  }

  .ai-box-grid__container-{{ ai_gen_id }} .ai-box-grid__box-{{ ai_gen_id }}:nth-child(3) {
    grid-column: 1 / 2;
  }

  .ai-box-grid__container-{{ ai_gen_id }} .ai-box-grid__box-{{ ai_gen_id }}:nth-child(4) {
    grid-column: 2 / 3;
  }

  .ai-box-grid__container-{{ ai_gen_id }} {
    grid-template-columns: 40% 60%;
  }

  .ai-box-grid__container-{{ ai_gen_id }} .ai-box-grid__box-{{ ai_gen_id }}:nth-child(n+3) {
    grid-row: 2;
  }

  .ai-box-grid__container-{{ ai_gen_id }} .ai-box-grid__box-{{ ai_gen_id }}:nth-child(3) {
    grid-column: 1 / 2;
  }

  .ai-box-grid__container-{{ ai_gen_id }} .ai-box-grid__box-{{ ai_gen_id }}:nth-child(4) {
    grid-column: 2 / 3;
  }

  .ai-box-grid__row-2-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 60% 40%;
    gap: 0 {{ block.settings.gap }}px;
  }

  .ai-box-grid__link-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 2;
  }

  .ai-box-grid__content-{{ ai_gen_id }} {
    position: relative;
    z-index: 1;
    width: 100%;
  }

  .ai-box-grid__title-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.title_size }}px;
    margin: 0;
    font-weight: 600;
  }

  .ai-box-grid__image-{{ ai_gen_id }} {
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
    width: 75%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
    object-position: right;
  }

  .ai-box-grid__image-placeholder-{{ ai_gen_id }} {
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
    width: 75%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f4f4f4;
    z-index: 0;
  }

  .ai-box-grid__image-placeholder-{{ ai_gen_id }} svg {
    width: 50%;
    height: 50%;
    opacity: 0.3;
  }

  @media screen and (max-width: 749px) {
    .ai-box-grid__container-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      grid-template-rows: repeat(4, auto);
    }

    .ai-box-grid__box-{{ ai_gen_id }} {
      min-height: 150px;
    }

    .ai-box-grid__box-{{ ai_gen_id }}:nth-child(1),
    .ai-box-grid__box-{{ ai_gen_id }}:nth-child(2),
    .ai-box-grid__box-{{ ai_gen_id }}:nth-child(3),
    .ai-box-grid__box-{{ ai_gen_id }}:nth-child(4) {
      grid-column: 1 / 2;
    }
    .ai-box-grid__box-{{ ai_gen_id }}:nth-child(1),
    .ai-box-grid__box-{{ ai_gen_id }}:nth-child(3){
      margin-bottom: 16px;
    }
    .ai-box-grid__row-2-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }

    .ai-box-grid__image-{{ ai_gen_id }} {
      width: 60%;
      object-position: left;
    }

    .ai-box-grid__image-placeholder-{{ ai_gen_id }} {
      width: 75%;
    }
    .ai-box-grid__title-{{ ai_gen_id }}{
      font-size: 24px;
    }
  }
{% endstyle %}

<box-grid-{{ ai_gen_id }} class="ai-box-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-box-grid__container-{{ ai_gen_id }}">
    {% for i in (1..2) %}
      {% liquid
        assign title_key = 'box_' | append: i | append: '_title'
        assign link_key = 'box_' | append: i | append: '_link'
        assign image_key = 'box_' | append: i | append: '_image'
        
        assign title = block.settings[title_key]
        assign link = block.settings[link_key]
        assign image = block.settings[image_key]
      %}
      
      <div class="ai-box-grid__box-{{ ai_gen_id }}">
        {% if link != blank %}
          <a href="{{ link }}" class="ai-box-grid__link-{{ ai_gen_id }}" aria-label="{{ title | escape }}"></a>
        {% endif %}
        
        <div class="ai-box-grid__content-{{ ai_gen_id }}">
          {% if title != blank %}
            <h3 class="ai-box-grid__title-{{ ai_gen_id }}">{{ title }}</h3>
          {% endif %}
        </div>
        
        {% if image != blank %}
          <img
            src="{{ image | image_url: width: 800 }}"
            alt="{{ image.alt | escape }}"
            class="ai-box-grid__image-{{ ai_gen_id }}"
            loading="lazy"
            width="{{ image.width }}"
            height="{{ image.height }}"
          >
        {% else %}
          <div class="ai-box-grid__image-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>
    {% endfor %}
  </div>

  <div class="ai-box-grid__row-2-{{ ai_gen_id }}" style="margin-top: {{ block.settings.gap }}px;">
    {% for i in (3..4) %}
      {% liquid
        assign title_key = 'box_' | append: i | append: '_title'
        assign link_key = 'box_' | append: i | append: '_link'
        assign image_key = 'box_' | append: i | append: '_image'
        
        assign title = block.settings[title_key]
        assign link = block.settings[link_key]
        assign image = block.settings[image_key]
      %}
      
      <div class="ai-box-grid__box-{{ ai_gen_id }}">
        {% if link != blank %}
          <a href="{{ link }}" class="ai-box-grid__link-{{ ai_gen_id }}" aria-label="{{ title | escape }}"></a>
        {% endif %}
        
        <div class="ai-box-grid__content-{{ ai_gen_id }}">
          {% if title != blank %}
            <h3 class="ai-box-grid__title-{{ ai_gen_id }}">{{ title }}</h3>
          {% endif %}
        </div>
        
        {% if image != blank %}
          <img
            src="{{ image | image_url: width: 800 }}"
            alt="{{ image.alt | escape }}"
            class="ai-box-grid__image-{{ ai_gen_id }}"
            loading="lazy"
            width="{{ image.width }}"
            height="{{ image.height }}"
          >
        {% else %}
          <div class="ai-box-grid__image-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</box-grid-{{ ai_gen_id }}>

